# =============================================================
# SectorStress — environment configuration
# Copy this file to `.env` and fill in real values.
# =============================================================

# Default sectors to fetch (comma-separated SPDR sector ETF tickers)
DEFAULT_SECTORS=XLF,XLE,XLK,XLV,XLI

# Rolling-window length in trading days for the stress indicator
ROLLING_WINDOW_DAYS=21

# Where to cache Yahoo Finance CSV pulls
DATA_CACHE_DIR=./data/cache

# CORS — comma-separated list of allowed origins for the FastAPI app
CORS_ORIGINS=http://localhost:5173
